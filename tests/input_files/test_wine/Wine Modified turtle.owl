@prefix : <http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix vin: <http://www.w3.org/TR/2003/PR-owl-guide-20031209/wine#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix food: <http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.w3.org/TR/2003/PR-owl-guide-20031209/food> .

<http://www.w3.org/TR/2003/PR-owl-guide-20031209/food> rdf:type owl:Ontology ;
                                                        owl:imports <http://www.w3.org/TR/2003/PR-owl-guide-20031209/wine> ;
                                                        rdfs:comment """
      Derived from the DAML Wine ontology at 
      http://ontolingua.stanford.edu/doc/chimaera/ontologies/wines.daml
      Substantially modified.
    """ .

#################################################################
#    Object Properties
#################################################################

###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#course
food:course rdf:type owl:ObjectProperty ;
            rdfs:domain food:Meal ;
            rdfs:range food:MealCourse .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#hasDrink
food:hasDrink rdf:type owl:ObjectProperty ;
              rdfs:domain food:MealCourse ;
              rdfs:range food:PotableLiquid .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#hasFood
food:hasFood rdf:type owl:ObjectProperty ;
             rdfs:domain food:MealCourse ;
             rdfs:range food:EdibleThing .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#madeFromFruit
food:madeFromFruit rdf:type owl:ObjectProperty ;
                   rdfs:domain food:ConsumableThing ;
                   rdfs:range food:Fruit .


#################################################################
#    Classes
#################################################################

###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#BlandFish
food:BlandFish rdf:type owl:Class ;
               rdfs:subClassOf food:Fish ;
               owl:disjointWith food:NonBlandFish .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#BlandFishCourse
food:BlandFishCourse rdf:type owl:Class ;
                     owl:equivalentClass [ owl:intersectionOf ( food:MealCourse
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty food:hasFood ;
                                                                  owl:allValuesFrom food:BlandFish
                                                                ]
                                                              ) ;
                                           rdf:type owl:Class
                                         ] ;
                     rdfs:subClassOf [ rdf:type owl:Restriction ;
                                       owl:onProperty food:hasDrink ;
                                       owl:allValuesFrom [ rdf:type owl:Restriction ;
                                                           owl:onProperty vin:hasFlavor ;
                                                           owl:hasValue food:Delicate
                                                         ]
                                     ] .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#CheeseNutsDessert
food:CheeseNutsDessert rdf:type owl:Class ;
                       rdfs:subClassOf food:Dessert ;
                       owl:disjointWith food:SweetDessert .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#CheeseNutsDessertCourse
food:CheeseNutsDessertCourse rdf:type owl:Class ;
                             owl:equivalentClass [ owl:intersectionOf ( food:MealCourse
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty food:hasFood ;
                                                                          owl:allValuesFrom food:CheeseNutsDessert
                                                                        ]
                                                                      ) ;
                                                   rdf:type owl:Class
                                                 ] ;
                             rdfs:subClassOf [ rdf:type owl:Restriction ;
                                               owl:onProperty food:hasDrink ;
                                               owl:allValuesFrom [ rdf:type owl:Restriction ;
                                                                   owl:onProperty vin:hasColor ;
                                                                   owl:hasValue food:Red
                                                                 ]
                                             ] .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#ConsumableThing
food:ConsumableThing rdf:type owl:Class .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#DarkMeatFowl
food:DarkMeatFowl rdf:type owl:Class ;
                  rdfs:subClassOf food:Fowl ;
                  owl:disjointWith food:LightMeatFowl .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#DarkMeatFowlCourse
food:DarkMeatFowlCourse rdf:type owl:Class ;
                        owl:equivalentClass [ owl:intersectionOf ( food:MealCourse
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty food:hasFood ;
                                                                     owl:allValuesFrom food:DarkMeatFowl
                                                                   ]
                                                                 ) ;
                                              rdf:type owl:Class
                                            ] ;
                        rdfs:subClassOf [ rdf:type owl:Restriction ;
                                          owl:onProperty food:hasDrink ;
                                          owl:allValuesFrom [ rdf:type owl:Restriction ;
                                                              owl:onProperty vin:hasBody ;
                                                              owl:hasValue food:Light
                                                            ]
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty food:hasDrink ;
                                          owl:allValuesFrom [ rdf:type owl:Restriction ;
                                                              owl:onProperty vin:hasColor ;
                                                              owl:hasValue food:Red
                                                            ]
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty food:hasDrink ;
                                          owl:allValuesFrom [ rdf:type owl:Restriction ;
                                                              owl:onProperty vin:hasFlavor ;
                                                              owl:hasValue food:Delicate
                                                            ]
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty food:hasDrink ;
                                          owl:allValuesFrom [ rdf:type owl:Restriction ;
                                                              owl:onProperty vin:hasSugar ;
                                                              owl:hasValue food:Dry
                                                            ]
                                        ] .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#Dessert
food:Dessert rdf:type owl:Class ;
             rdfs:subClassOf food:EdibleThing ;
             owl:disjointWith food:Fowl ,
                              food:Fruit ,
                              food:Meat ,
                              food:OtherTomatoBasedFood ,
                              food:Pasta ,
                              food:Seafood .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#DessertCourse
food:DessertCourse rdf:type owl:Class ;
                   owl:equivalentClass [ owl:intersectionOf ( food:MealCourse
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty food:hasFood ;
                                                                owl:allValuesFrom food:Dessert
                                                              ]
                                                            ) ;
                                         rdf:type owl:Class
                                       ] ;
                   rdfs:subClassOf [ rdf:type owl:Restriction ;
                                     owl:onProperty food:hasDrink ;
                                     owl:allValuesFrom [ rdf:type owl:Restriction ;
                                                         owl:onProperty vin:hasBody ;
                                                         owl:hasValue food:Full
                                                       ]
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty food:hasDrink ;
                                     owl:allValuesFrom [ rdf:type owl:Restriction ;
                                                         owl:onProperty vin:hasFlavor ;
                                                         owl:hasValue food:Strong
                                                       ]
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty food:hasDrink ;
                                     owl:allValuesFrom [ rdf:type owl:Restriction ;
                                                         owl:onProperty vin:hasSugar ;
                                                         owl:hasValue food:Sweet
                                                       ]
                                   ] .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#EatingGrape
food:EatingGrape rdf:type owl:Class ;
                 rdfs:subClassOf food:Grape .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#EdibleThing
food:EdibleThing rdf:type owl:Class ;
                 rdfs:subClassOf food:ConsumableThing ;
                 owl:disjointWith food:Meal ,
                                  food:MealCourse ,
                                  food:PotableLiquid .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#Fish
food:Fish rdf:type owl:Class ;
          rdfs:subClassOf food:Seafood ;
          owl:disjointWith food:Shellfish .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#FishCourse
food:FishCourse rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( food:MealCourse
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty food:hasFood ;
                                                             owl:allValuesFrom food:Fish
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf [ rdf:type owl:Restriction ;
                                  owl:onProperty food:hasDrink ;
                                  owl:allValuesFrom [ rdf:type owl:Restriction ;
                                                      owl:onProperty vin:hasBody ;
                                                      owl:hasValue food:Medium
                                                    ]
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty food:hasDrink ;
                                  owl:allValuesFrom [ rdf:type owl:Restriction ;
                                                      owl:onProperty vin:hasSugar ;
                                                      owl:hasValue food:Dry
                                                    ]
                                ] .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#Fowl
food:Fowl rdf:type owl:Class ;
          rdfs:subClassOf food:EdibleThing ;
          owl:disjointWith food:Fruit ,
                           food:Meat ,
                           food:OtherTomatoBasedFood ,
                           food:Pasta ,
                           food:Seafood .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#Fruit
food:Fruit rdf:type owl:Class ;
           owl:equivalentClass [ rdf:type owl:Class ;
                                 owl:unionOf ( food:NonSweetFruit
                                               food:SweetFruit
                                             )
                               ] ;
           owl:disjointWith food:Meat ,
                            food:OtherTomatoBasedFood ,
                            food:Pasta ,
                            food:Seafood .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#FruitCourse
food:FruitCourse rdf:type owl:Class ;
                 owl:equivalentClass [ owl:intersectionOf ( food:MealCourse
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty food:hasFood ;
                                                              owl:allValuesFrom food:Fruit
                                                            ]
                                                          ) ;
                                       rdf:type owl:Class
                                     ] ;
                 rdfs:subClassOf [ rdf:type owl:Restriction ;
                                   owl:onProperty food:hasDrink ;
                                   owl:allValuesFrom [ rdf:type owl:Restriction ;
                                                       owl:onProperty vin:hasBody ;
                                                       owl:hasValue food:Medium
                                                     ]
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty food:hasDrink ;
                                   owl:allValuesFrom [ rdf:type owl:Restriction ;
                                                       owl:onProperty vin:hasColor ;
                                                       owl:hasValue food:White
                                                     ]
                                 ] .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#Grape
food:Grape rdf:type owl:Class ;
           rdfs:subClassOf food:SweetFruit .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#Juice
food:Juice rdf:type owl:Class ;
           rdfs:subClassOf food:PotableLiquid ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty food:madeFromFruit ;
                             owl:minCardinality "1"^^xsd:nonNegativeInteger
                           ] .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#LightMeatFowl
food:LightMeatFowl rdf:type owl:Class ;
                   rdfs:subClassOf food:Fowl .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#LightMeatFowlCourse
food:LightMeatFowlCourse rdf:type owl:Class ;
                         owl:equivalentClass [ owl:intersectionOf ( food:MealCourse
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty food:hasFood ;
                                                                      owl:allValuesFrom food:LightMeatFowl
                                                                    ]
                                                                  ) ;
                                               rdf:type owl:Class
                                             ] ;
                         rdfs:subClassOf [ rdf:type owl:Restriction ;
                                           owl:onProperty food:hasDrink ;
                                           owl:allValuesFrom [ rdf:type owl:Restriction ;
                                                               owl:onProperty vin:hasBody ;
                                                               owl:hasValue food:Medium
                                                             ]
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty food:hasDrink ;
                                           owl:allValuesFrom [ rdf:type owl:Restriction ;
                                                               owl:onProperty vin:hasColor ;
                                                               owl:hasValue food:White
                                                             ]
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty food:hasDrink ;
                                           owl:allValuesFrom [ rdf:type owl:Restriction ;
                                                               owl:onProperty vin:hasFlavor ;
                                                               owl:hasValue food:Moderate
                                                             ]
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty food:hasDrink ;
                                           owl:allValuesFrom [ rdf:type owl:Restriction ;
                                                               owl:onProperty vin:hasSugar ;
                                                               owl:hasValue food:Dry
                                                             ]
                                         ] .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#Meal
food:Meal rdf:type owl:Class ;
          rdfs:subClassOf food:ConsumableThing ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty food:course ;
                            owl:allValuesFrom food:MealCourse
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty food:course ;
                            owl:minCardinality "1"^^xsd:nonNegativeInteger
                          ] ;
          owl:disjointWith food:MealCourse ,
                           food:PotableLiquid .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#MealCourse
food:MealCourse rdf:type owl:Class ;
                rdfs:subClassOf food:ConsumableThing ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty food:hasDrink ;
                                  owl:allValuesFrom food:Wine
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty food:hasDrink ;
                                  owl:minCardinality "1"^^xsd:nonNegativeInteger
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty food:hasFood ;
                                  owl:minCardinality "1"^^xsd:nonNegativeInteger
                                ] ;
                owl:disjointWith food:PotableLiquid .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#Meat
food:Meat rdf:type owl:Class ;
          rdfs:subClassOf food:EdibleThing ;
          owl:disjointWith food:OtherTomatoBasedFood ,
                           food:Pasta ,
                           food:Seafood .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#NonBlandFish
food:NonBlandFish rdf:type owl:Class ;
                  rdfs:subClassOf food:Fish .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#NonBlandFishCourse
food:NonBlandFishCourse rdf:type owl:Class ;
                        owl:equivalentClass [ owl:intersectionOf ( food:MealCourse
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty food:hasFood ;
                                                                     owl:allValuesFrom food:NonBlandFish
                                                                   ]
                                                                 ) ;
                                              rdf:type owl:Class
                                            ] ;
                        rdfs:subClassOf [ rdf:type owl:Restriction ;
                                          owl:onProperty food:hasDrink ;
                                          owl:allValuesFrom [ rdf:type owl:Restriction ;
                                                              owl:onProperty vin:hasFlavor ;
                                                              owl:hasValue food:Moderate
                                                            ]
                                        ] .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#NonConsumableThing
food:NonConsumableThing rdf:type owl:Class .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#NonOysterShellfish
food:NonOysterShellfish rdf:type owl:Class ;
                        rdfs:subClassOf food:Shellfish ;
                        owl:disjointWith food:OysterShellfish .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#NonOysterShellfishCourse
food:NonOysterShellfishCourse rdf:type owl:Class ;
                              owl:equivalentClass [ owl:intersectionOf ( food:MealCourse
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty food:hasFood ;
                                                                           owl:allValuesFrom food:NonOysterShellfish
                                                                         ]
                                                                       ) ;
                                                    rdf:type owl:Class
                                                  ] ;
                              rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                owl:onProperty food:hasDrink ;
                                                owl:allValuesFrom [ rdf:type owl:Restriction ;
                                                                    owl:onProperty vin:hasSugar ;
                                                                    owl:hasValue food:Dry
                                                                  ]
                                              ] .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#NonRedMeat
food:NonRedMeat rdf:type owl:Class ;
                rdfs:subClassOf food:Meat ;
                owl:disjointWith food:RedMeat .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#NonRedMeatCourse
food:NonRedMeatCourse rdf:type owl:Class ;
                      owl:equivalentClass [ owl:intersectionOf ( food:MealCourse
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty food:hasFood ;
                                                                   owl:allValuesFrom food:NonRedMeat
                                                                 ]
                                                               ) ;
                                            rdf:type owl:Class
                                          ] ;
                      rdfs:subClassOf [ rdf:type owl:Restriction ;
                                        owl:onProperty food:hasDrink ;
                                        owl:allValuesFrom [ rdf:type owl:Restriction ;
                                                            owl:onProperty vin:hasBody ;
                                                            owl:hasValue food:Medium
                                                          ]
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty food:hasDrink ;
                                        owl:allValuesFrom [ rdf:type owl:Restriction ;
                                                            owl:onProperty vin:hasColor ;
                                                            owl:hasValue food:White
                                                          ]
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty food:hasDrink ;
                                        owl:allValuesFrom [ rdf:type owl:Restriction ;
                                                            owl:onProperty vin:hasFlavor ;
                                                            owl:hasValue food:Strong
                                                          ]
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty food:hasDrink ;
                                        owl:allValuesFrom [ rdf:type owl:Restriction ;
                                                            owl:onProperty vin:hasSugar ;
                                                            owl:hasValue food:Dry
                                                          ]
                                      ] .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#NonSpicyRedMeat
food:NonSpicyRedMeat rdf:type owl:Class ;
                     rdfs:subClassOf food:RedMeat ;
                     owl:disjointWith food:SpicyRedMeat .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#NonSpicyRedMeatCourse
food:NonSpicyRedMeatCourse rdf:type owl:Class ;
                           owl:equivalentClass [ owl:intersectionOf ( food:MealCourse
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty food:hasFood ;
                                                                        owl:allValuesFrom food:NonSpicyRedMeat
                                                                      ]
                                                                    ) ;
                                                 rdf:type owl:Class
                                               ] ;
                           rdfs:subClassOf [ rdf:type owl:Restriction ;
                                             owl:onProperty food:hasDrink ;
                                             owl:allValuesFrom [ rdf:type owl:Restriction ;
                                                                 owl:onProperty vin:hasFlavor ;
                                                                 owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                     owl:oneOf ( food:Moderate
                                                                                                 food:Strong
                                                                                               )
                                                                                   ]
                                                               ]
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty food:hasDrink ;
                                             owl:allValuesFrom [ rdf:type owl:Restriction ;
                                                                 owl:onProperty vin:hasBody ;
                                                                 owl:hasValue food:Medium
                                                               ]
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty food:hasDrink ;
                                             owl:allValuesFrom [ rdf:type owl:Restriction ;
                                                                 owl:onProperty vin:hasColor ;
                                                                 owl:hasValue food:Red
                                                               ]
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty food:hasDrink ;
                                             owl:allValuesFrom [ rdf:type owl:Restriction ;
                                                                 owl:onProperty vin:hasSugar ;
                                                                 owl:hasValue food:Dry
                                                               ]
                                           ] .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#NonSweetFruit
food:NonSweetFruit rdf:type owl:Class ;
                   rdfs:subClassOf food:EdibleThing ;
                   owl:disjointWith food:SweetFruit .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#NonSweetFruitCourse
food:NonSweetFruitCourse rdf:type owl:Class ;
                         owl:equivalentClass [ owl:intersectionOf ( food:MealCourse
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty food:hasFood ;
                                                                      owl:allValuesFrom food:NonSweetFruit
                                                                    ]
                                                                  ) ;
                                               rdf:type owl:Class
                                             ] ;
                         rdfs:subClassOf [ rdf:type owl:Restriction ;
                                           owl:onProperty food:hasDrink ;
                                           owl:allValuesFrom [ rdf:type owl:Restriction ;
                                                               owl:onProperty vin:hasFlavor ;
                                                               owl:hasValue food:Delicate
                                                             ]
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty food:hasDrink ;
                                           owl:allValuesFrom [ rdf:type owl:Restriction ;
                                                               owl:onProperty vin:hasSugar ;
                                                               owl:hasValue food:OffDry
                                                             ]
                                         ] .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#OtherTomatoBasedFood
food:OtherTomatoBasedFood rdf:type owl:Class ;
                          rdfs:subClassOf food:EdibleThing ;
                          owl:disjointWith food:Pasta ,
                                           food:Seafood .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#OtherTomatoBasedFoodCourse
food:OtherTomatoBasedFoodCourse rdf:type owl:Class ;
                                owl:equivalentClass [ owl:intersectionOf ( food:MealCourse
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty food:hasFood ;
                                                                             owl:allValuesFrom food:OtherTomatoBasedFood
                                                                           ]
                                                                         ) ;
                                                      rdf:type owl:Class
                                                    ] ;
                                rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                  owl:onProperty food:hasDrink ;
                                                  owl:allValuesFrom [ rdf:type owl:Restriction ;
                                                                      owl:onProperty vin:hasBody ;
                                                                      owl:hasValue food:Medium
                                                                    ]
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty food:hasDrink ;
                                                  owl:allValuesFrom [ rdf:type owl:Restriction ;
                                                                      owl:onProperty vin:hasColor ;
                                                                      owl:hasValue food:Red
                                                                    ]
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty food:hasDrink ;
                                                  owl:allValuesFrom [ rdf:type owl:Restriction ;
                                                                      owl:onProperty vin:hasFlavor ;
                                                                      owl:hasValue food:Moderate
                                                                    ]
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty food:hasDrink ;
                                                  owl:allValuesFrom [ rdf:type owl:Restriction ;
                                                                      owl:onProperty vin:hasSugar ;
                                                                      owl:hasValue food:Dry
                                                                    ]
                                                ] .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#OysterShellfish
food:OysterShellfish rdf:type owl:Class ;
                     rdfs:subClassOf food:Shellfish .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#OysterShellfishCourse
food:OysterShellfishCourse rdf:type owl:Class ;
                           owl:equivalentClass [ owl:intersectionOf ( food:MealCourse
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty food:hasFood ;
                                                                        owl:allValuesFrom food:OysterShellfish
                                                                      ]
                                                                    ) ;
                                                 rdf:type owl:Class
                                               ] ;
