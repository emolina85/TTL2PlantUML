<http://www.semanticweb.org/midos/ontologies/2022/11/untitled-ontology-14> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/midos/ontologies/2022/11/untitled-ontology-14#belonging_to
:belonging_to rdf:type owl:ObjectProperty ;
              rdfs:domain :TA ;
              rdfs:range :Department .


###  http://www.semanticweb.org/midos/ontologies/2022/11/untitled-ontology-14#faculties_of_university
:faculties_of_university rdf:type owl:ObjectProperty ;
                         rdfs:domain :University ;
                         rdfs:range :Faculty .


###  http://www.semanticweb.org/midos/ontologies/2022/11/untitled-ontology-14#is_studying
:is_studying rdf:type owl:ObjectProperty ;
             rdfs:domain :Student ;
             rdfs:range :Course .


###  http://www.semanticweb.org/midos/ontologies/2022/11/untitled-ontology-14#lecturers_of_faculty
:lecturers_of_faculty rdf:type owl:ObjectProperty ;
                      rdfs:domain :Faculty ;
                      rdfs:range :Lecturer .


###  http://www.semanticweb.org/midos/ontologies/2022/11/untitled-ontology-14#offered_by
:offered_by rdf:type owl:ObjectProperty ;
            owl:inverseOf :offers ;
            rdfs:domain :Course ;
            rdfs:range :Faculty .


###  http://www.semanticweb.org/midos/ontologies/2022/11/untitled-ontology-14#offers
:offers rdf:type owl:ObjectProperty ;
        rdfs:domain :Faculty ;
        rdfs:range :Course .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/midos/ontologies/2022/11/untitled-ontology-14#course_code
:course_code rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf owl:topDataProperty ;
             rdfs:domain :Course ;
             rdfs:range xsd:string .


###  http://www.semanticweb.org/midos/ontologies/2022/11/untitled-ontology-14#department_code
:department_code rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf owl:topDataProperty ;
                 rdfs:domain :Department ,
                             [ rdf:type owl:Class ;
                               owl:unionOf ( [ rdf:type owl:Restriction ;
                                               owl:onProperty :department_code ;
                                               owl:hasValue "AI"
                                             ]
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty :department_code ;
                                               owl:hasValue "CS"
                                             ]
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty :department_code ;
                                               owl:hasValue "DS"
                                             ]
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty :department_code ;
                                               owl:hasValue "IS"
                                             ]
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty :department_code ;
                                               owl:hasValue "IT"
                                             ]
                                           )
                             ] ;
                 rdfs:range xsd:string .


###  http://www.semanticweb.org/midos/ontologies/2022/11/untitled-ontology-14#grade
:grade rdf:type owl:DatatypeProperty ;
       rdfs:subPropertyOf owl:topDataProperty ;
       rdfs:domain :Student ,
                   [ rdf:type owl:Restriction ;
                     owl:onProperty :grade ;
                     owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                     owl:onDataRange xsd:double
                   ] ,
                   [ rdf:type owl:Restriction ;
                     owl:onProperty :grade ;
                     owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
                     owl:onDataRange xsd:double
                   ] ;
       rdfs:range xsd:double .


###  http://www.semanticweb.org/midos/ontologies/2022/11/untitled-ontology-14#location
:location rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf owl:topDataProperty ;
          rdfs:domain :University ;
          rdfs:range xsd:string .


###  http://www.semanticweb.org/midos/ontologies/2022/11/untitled-ontology-14#name
:name rdf:type owl:DatatypeProperty ;
      rdfs:subPropertyOf owl:topDataProperty ;
      rdfs:domain :University ;
      rdfs:range xsd:string .


###  http://www.semanticweb.org/midos/ontologies/2022/11/untitled-ontology-14#student_id
:student_id rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdfs:domain :Student ;
            rdfs:range xsd:string .


