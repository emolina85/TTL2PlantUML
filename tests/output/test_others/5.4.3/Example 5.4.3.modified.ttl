@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix lis: <http://rds.posccaesar.org/ontology/lis14/rdl/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix cfihos: <http://data.cfihos.org/rdl/> .
@prefix ex: <http://example.com/> .

cfihos:CFIHOS-30000521E a owl:Class ;
    rdfs:label "centrifugal pump" .

cfihos:CFIHOS-xxxx1 a owl:Class ;
    rdfs:subClassOf cfihos:CFIHOS-xxxx2,   
    [ rdf:type owl:Restriction ;           
      owl:onProperty cfihos:hasPropertyAspect ;
      owl:allValuesFrom cfihos:CFIHOS-xxxx3
    ] ;
    rdfs:label "design pressure"  .  

cfihos:CFIHOS-xxxx2 a owl:Class ;
    rdfs:label "pressure" .

cfihos:CFIHOS-xxxx3 a owl:Class ;
    rdfs:subClassOf cfihos:ScopeAspect ;
    rdfs:label "design" .


cfihos:hasPropertyAspect a owl:ObjectProperty.   

cfihos:ScopeAspect a owl:Class ;
    rdfs:label "ScopeAspect" .

cfihos:RealMeasureTypeDatum a owl:Class ;
    rdfs:label "RealMeasureTypeDatum" .

unit:Bar a owl:Class ;
    rdfs:label "bar" .

lis:hasQuality a owl:ObjectProperty .            

lis:QualityQuantifiedAs a owl:ObjectProperty .   



lis:datumValue a owl:DatatypeProperty .     

lis:datumUOM a owl:ObjectProperty .         


ex:2384 a owl:Class ;
    rdfs:subClassOf cfihos:CFIHOS-30000521E ;
    lis:hasQuality ex:8453.                       

ex:8453 a owl:Class ;
    rdfs:subClassOf cfihos:CFIHOS-xxxx1 ;
    lis:QualityQuantifiedAs ex:7533 .

ex:7533 a owl:Class ;
    rdfs:subClassOf cfihos:RealMeasureTypeDatum ;              
    lis:datumValue "10.0"^^xsd:string ;
    lis:datumUOM unit:Bar .






             


lis:hasQuality
    a rdf:Property ;
    a owl:ObjectProperty ;
    rdfs:domain ex:2384 ;
    rdfs:range ex:8453 .

lis:hasQuality
    rdfs:label "hasQuality" .

lis:QualityQuantifiedAs
    a rdf:Property ;
    a owl:ObjectProperty ;
    rdfs:domain ex:8453 ;
    rdfs:range ex:7533 .

lis:QualityQuantifiedAs
    rdfs:label "QualityQuantifiedAs" .

lis:datumUOM
    a rdf:Property ;
    a owl:ObjectProperty ;
    rdfs:domain ex:7533 ;
    rdfs:range unit:Bar .

lis:datumUOM
    rdfs:label "datumUOM" .
