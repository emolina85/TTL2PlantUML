###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/wine#WhiteNonSweetWine
vin:WhiteNonSweetWine rdf:type owl:Class ;
                      owl:equivalentClass [ owl:intersectionOf ( vin:WhiteWine
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty vin:hasSugar ;
                                                                   owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                       owl:oneOf ( vin:Dry
                                                                                                   vin:OffDry
                                                                                                 )
                                                                                     ]
                                                                 ]
                                                               ) ;
                                            rdf:type owl:Class
                                          ] .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/wine#WhiteTableWine
vin:WhiteTableWine rdf:type owl:Class ;
                   owl:equivalentClass [ owl:intersectionOf ( vin:TableWine
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty vin:hasColor ;
                                                                owl:hasValue vin:White
                                                              ]
                                                            ) ;
                                         rdf:type owl:Class
                                       ] .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/wine#WhiteWine
vin:WhiteWine rdf:type owl:Class ;
              owl:equivalentClass [ owl:intersectionOf ( vin:Wine
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty vin:hasColor ;
                                                           owl:hasValue vin:White
                                                         ]
                                                       ) ;
                                    rdf:type owl:Class
                                  ] .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/wine#Wine
vin:Wine rdf:type owl:Class ;
         rdfs:subClassOf food:PotableLiquid ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty vin:locatedIn ;
                           owl:someValuesFrom vin:Region
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty vin:hasMaker ;
                           owl:allValuesFrom vin:Winery
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty vin:madeFromGrape ;
                           owl:minCardinality "1"^^xsd:nonNegativeInteger
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty vin:hasBody ;
                           owl:cardinality "1"^^xsd:nonNegativeInteger
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty vin:hasColor ;
                           owl:cardinality "1"^^xsd:nonNegativeInteger
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty vin:hasFlavor ;
                           owl:cardinality "1"^^xsd:nonNegativeInteger
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty vin:hasMaker ;
                           owl:cardinality "1"^^xsd:nonNegativeInteger
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty vin:hasSugar ;
                           owl:cardinality "1"^^xsd:nonNegativeInteger
                         ] ;
         rdfs:label "vin"@fr ,
                    "wine"@en .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/wine#WineBody
vin:WineBody rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Class ;
                                   owl:oneOf ( vin:Full
                                               vin:Light
                                               vin:Medium
                                             )
                                 ] ;
             rdfs:subClassOf vin:WineTaste .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/wine#WineColor
vin:WineColor rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Class ;
                                    owl:oneOf ( vin:Red
                                                vin:Rose
                                                vin:White
                                              )
                                  ] ;
              rdfs:subClassOf vin:WineDescriptor .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/wine#WineDescriptor
vin:WineDescriptor rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Class ;
                                         owl:unionOf ( vin:WineColor
                                                       vin:WineTaste
                                                     )
                                       ] ;
                   rdfs:comment "Made WineDescriptor unionType of tastes and color" .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/wine#WineFlavor
vin:WineFlavor rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Class ;
                                     owl:oneOf ( vin:Delicate
                                                 vin:Moderate
                                                 vin:Strong
                                               )
                                   ] ;
               rdfs:subClassOf vin:WineTaste .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/wine#WineGrape
vin:WineGrape rdf:type owl:Class ;
              rdfs:subClassOf food:Grape .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/wine#WineSugar
vin:WineSugar rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Class ;
                                    owl:oneOf ( vin:Dry
                                                vin:OffDry
                                                vin:Sweet
                                              )
                                  ] ;
              rdfs:subClassOf vin:WineTaste .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/wine#WineTaste
vin:WineTaste rdf:type owl:Class ;
              rdfs:subClassOf vin:WineDescriptor .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/wine#Winery
vin:Winery rdf:type owl:Class .


###  http://www.w3.org/TR/2003/PR-owl-guide-20031209/wine#Zinfandel
vin:Zinfandel rdf:type owl:Class ;
              owl:equivalentClass [ owl:intersectionOf ( vin:Wine
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty vin:madeFromGrape ;
                                                           owl:hasValue vin:ZinfandelGrape
                                                         ]
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty vin:madeFromGrape ;
                                                           owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                         ]
                                                       ) ;
                                    rdf:type owl:Class
                                  ] ;
              rdfs:subClassOf [ rdf:type owl:Restriction ;
                                owl:onProperty vin:hasBody ;
                                owl:allValuesFrom [ rdf:type owl:Class ;
                                                    owl:oneOf ( vin:Full
                                                                vin:Medium
                                                              )
                                                  ]
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty vin:hasFlavor ;
                                owl:allValuesFrom [ rdf:type owl:Class ;
                                                    owl:oneOf ( vin:Moderate
                                                                vin:Strong
                                                              )
                                                  ]
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty vin:hasColor ;
                                owl:hasValue vin:Red
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty vin:hasSugar ;
                                owl:hasValue vin:Dry
                              ] .


