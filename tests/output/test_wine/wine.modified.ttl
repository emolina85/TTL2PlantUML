#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( vin:Bancroft
                        vin:ChateauChevalBlanc
                        vin:ChateauDYchem
                        vin:ChateauDeMeursault
                        vin:ChateauLafiteRothschild
